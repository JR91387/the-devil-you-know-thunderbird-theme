{
  "manifest_version": 2,
  "name": "The Devil You Know",
  "version": "0.1.0",
  "description": "A crisp light and dark look that feels like the office mail app you already know: white panes, one blue accent and clear lines.",
  "author": "Jerry Reinitz",
  "homepage_url": "https://github.com/JR91387/the-devil-you-know-thunderbird-theme",
  "browser_specific_settings": {
    "gecko": {
      "id": "the-devil-you-know@jerryreinitz.com",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/JR91387/the-devil-you-know-thunderbird-theme/main/updates.json"
    }
  },
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#F0F0F0",
      "frame_inactive": "#F5F5F5",
      "tab_background_text": "#424242",
      "tab_selected": "#FFFFFF",
      "tab_text": "#242424",
      "tab_line": "#0F6CBD",
      "tab_background_separator": "#E0E0E0",
      "toolbar": "#F0F0F0",
      "toolbar_text": "#242424",
      "toolbar_bottom_separator": "#E0E0E0",
      "toolbar_vertical_separator": "#E0E0E0",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#242424",
      "toolbar_field_border": "#D1D1D1",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#242424",
      "toolbar_field_border_focus": "#0F6CBD",
      "toolbar_field_highlight": "#CFE4FA",
      "toolbar_field_highlight_text": "#242424",
      "button_background_hover": "#E6E6E6",
      "button_background_active": "#D6D6D6",
      "icons": "#424242",
      "icons_attention": "#0F6CBD",
      "popup": "#FFFFFF",
      "popup_text": "#242424",
      "popup_border": "#E0E0E0",
      "popup_highlight": "#EBF3FC",
      "popup_highlight_text": "#242424",
      "sidebar": "#FAFAFA",
      "sidebar_text": "#242424",
      "sidebar_border": "#E0E0E0",
      "sidebar_highlight": "#CFE4FA",
      "sidebar_highlight_text": "#242424"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#1F1F1F",
      "frame_inactive": "#242424",
      "tab_background_text": "#D6D6D6",
      "tab_selected": "#292929",
      "tab_text": "#FFFFFF",
      "tab_line": "#62ABF5",
      "tab_background_separator": "#3D3D3D",
      "toolbar": "#1F1F1F",
      "toolbar_text": "#FFFFFF",
      "toolbar_bottom_separator": "#3D3D3D",
      "toolbar_vertical_separator": "#3D3D3D",
      "toolbar_field": "#292929",
      "toolbar_field_text": "#FFFFFF",
      "toolbar_field_border": "#525252",
      "toolbar_field_focus": "#292929",
      "toolbar_field_text_focus": "#FFFFFF",
      "toolbar_field_border_focus": "#62ABF5",
      "toolbar_field_highlight": "#0E4775",
      "toolbar_field_highlight_text": "#FFFFFF",
      "button_background_hover": "#333333",
      "button_background_active": "#3D3D3D",
      "icons": "#D6D6D6",
      "icons_attention": "#62ABF5",
      "popup": "#292929",
      "popup_text": "#FFFFFF",
      "popup_border": "#3D3D3D",
      "popup_highlight": "#183450",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#242424",
      "sidebar_text": "#FFFFFF",
      "sidebar_border": "#3D3D3D",
      "sidebar_highlight": "#0E4775",
      "sidebar_highlight_text": "#FFFFFF"
    }
  },
  "theme_experiment": {
    "stylesheet": "theme.css"
  }
}
